{
  "rules": [
    {
      "description": "Online antiguo",
      "expression": "http.host eq \"online.sistemabrio.com\"",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://online.briorol.com\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    },
    {
      "description": "Sistema antiguo y www",
      "expression": "(http.host eq \"sistemabrio.com\") or (http.host eq \"www.sistemabrio.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://sistema.briorol.com\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
